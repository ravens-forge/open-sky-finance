    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "assets_accounts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"assets_accounts\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"currency\" TEXT NOT NULL, \"is_hidden\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_hidden\" IN (0, 1)), \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"exclude_from_net_worth\" INTEGER NOT NULL DEFAULT 0 CHECK (\"exclude_from_net_worth\" IN (0, 1)), \"credit_limit\" INTEGER NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"notes\" TEXT NOT NULL DEFAULT '', \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (length(name) BETWEEN 1 AND 100), CHECK (currency GLOB '[A-Z][A-Z][A-Z]'));"
        }
      ]
    },
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"parent_id\" TEXT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"icon\" TEXT NOT NULL, \"color\" INTEGER NULL, \"is_hidden\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_hidden\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"), CHECK (length(name) BETWEEN 1 AND 100), CHECK (parent_id IS NOT NULL OR color IS NOT NULL), CHECK (parent_id IS NULL OR parent_id <> id));"
        }
      ]
    },
    {
      "name": "reminders",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reminders\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"title\" TEXT NOT NULL DEFAULT '', \"amount\" INTEGER NOT NULL, \"assets_account_id\" TEXT NOT NULL REFERENCES assets_accounts (id) ON DELETE CASCADE, \"to_assets_account_id\" TEXT NULL REFERENCES assets_accounts (id) ON DELETE CASCADE, \"to_amount\" INTEGER NULL, \"category_id\" TEXT NULL REFERENCES categories (id) ON DELETE SET NULL, \"currency\" TEXT NOT NULL, \"notes\" TEXT NOT NULL DEFAULT '', \"frequency\" TEXT NOT NULL, \"interval\" INTEGER NOT NULL DEFAULT 1, \"start_date\" TEXT NOT NULL, \"next_due_at\" TEXT NULL, \"end_date\" TEXT NULL, \"remaining_occurrences\" INTEGER NULL, \"auto_post\" INTEGER NOT NULL DEFAULT 0 CHECK (\"auto_post\" IN (0, 1)), \"notify\" INTEGER NOT NULL DEFAULT 0 CHECK (\"notify\" IN (0, 1)), \"is_paused\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_paused\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (type <> 'transfer' OR (to_assets_account_id IS NOT NULL AND to_assets_account_id <> assets_account_id AND amount > 0 AND category_id IS NULL AND (to_amount IS NULL OR to_amount > 0))), CHECK (type = 'transfer' OR (to_assets_account_id IS NULL AND to_amount IS NULL)), CHECK (currency GLOB '[A-Z][A-Z][A-Z]'), CHECK (type <> 'openingBalance'), CHECK (interval >= 1));"
        }
      ]
    },
    {
      "name": "transactions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"transactions\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"occurred_at\" TEXT NOT NULL, \"title\" TEXT NOT NULL DEFAULT '', \"amount\" INTEGER NOT NULL, \"assets_account_id\" TEXT NOT NULL REFERENCES assets_accounts (id) ON DELETE CASCADE, \"to_assets_account_id\" TEXT NULL REFERENCES assets_accounts (id) ON DELETE CASCADE, \"to_amount\" INTEGER NULL, \"category_id\" TEXT NULL REFERENCES categories (id) ON DELETE SET NULL, \"currency\" TEXT NOT NULL, \"exchange_rate\" TEXT NULL, \"notes\" TEXT NOT NULL DEFAULT '', \"reminder_id\" TEXT NULL REFERENCES reminders (id) ON DELETE SET NULL, \"deleted_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (type <> 'transfer' OR (to_assets_account_id IS NOT NULL AND to_assets_account_id <> assets_account_id AND amount > 0 AND category_id IS NULL AND (to_amount IS NULL OR to_amount > 0))), CHECK (type = 'transfer' OR (to_assets_account_id IS NULL AND to_amount IS NULL)), CHECK (currency GLOB '[A-Z][A-Z][A-Z]'), CHECK (type = 'transfer' OR exchange_rate IS NULL), CHECK (type <> 'openingBalance' OR category_id IS NULL));"
        }
      ]
    },
