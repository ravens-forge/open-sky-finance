          "sql": "CREATE TABLE IF NOT EXISTS \"labels\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL UNIQUE COLLATE NOCASE CHECK (length(name) BETWEEN 1 AND 100), PRIMARY KEY (\"id\"));"
