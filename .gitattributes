# Normalize line endings: LF in the repository, native in the working tree.
* text=auto eol=lf

# Windows tooling
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.otf binary
*.fydb binary
*.keystore binary
*.jks binary

# Generated / vendored files: collapse in diffs and exclude from language stats
*.g.dart linguist-generated=true
*.drift.dart linguist-generated=true
*.freezed.dart linguist-generated=true
