{
  "@@locale": "en",
  "appTitle": "Open Sky Finance",
  "@appTitle": {
    "description": "Application name, shown in the task switcher and the about screen"
  },
  "amountIncomeSemantic": "income, {amount}",
  "@amountIncomeSemantic": {
    "description": "Screen reader label of a positive income or refund amount. {amount} is the formatted amount, e.g. €12.50",
    "placeholders": {
      "amount": {
        "type": "String"
      }
    }
  },
  "amountExpenseSemantic": "expense, {amount}",
  "@amountExpenseSemantic": {
    "description": "Screen reader label of an expense amount (shown with a minus sign). {amount} is the formatted amount without sign",
    "placeholders": {
      "amount": {
        "type": "String"
      }
    }
  },
  "amountTransferSemantic": "transfer, {amount}",
  "@amountTransferSemantic": {
    "description": "Screen reader label of a transfer amount. {amount} is the formatted amount",
    "placeholders": {
      "amount": {
        "type": "String"
      }
    }
  },
  "amountNegativeSemantic": "minus {amount}",
  "@amountNegativeSemantic": {
    "description": "Screen reader label of a negative balance or total. {amount} is the formatted amount without sign",
    "placeholders": {
      "amount": {
        "type": "String"
      }
    }
  },
